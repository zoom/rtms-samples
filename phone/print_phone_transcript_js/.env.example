# Zoom General app credentials (Basic Information page).
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
# Webhook Secret Token (Access page) used to verify webhook signatures.
ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"

PORT=3000
WEBHOOK_PATH="/webhook"
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Set false to log transcript lengths instead of call content.
LOG_TRANSCRIPT_TEXT=true
