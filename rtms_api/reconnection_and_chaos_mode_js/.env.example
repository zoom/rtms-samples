# Zoom App Credentials
# Get these from https://marketplace.zoom.us/ → your app → App Credentials
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Server Configuration
PORT=3000
WEBHOOK_PATH=/webhook

# ============================================================
# Chaos Mode Configuration
# ============================================================
# Chaos mode deliberately suppresses keep-alive responses to induce
# server disconnection. This lets you observe the reconnection flow.
#
# The RTMS server sends keep-alive pings every ~10 seconds. If we miss
# 3 consecutive pings, the server terminates the connection.
#
# CHAOS_SUPPRESS_SIGNALING_KEEPALIVE=true
#   → Server terminates BOTH signaling + media after ~30s
#   → Triggers Scenario 2: meeting.rtms_interrupted webhook
#   → App reconnects both sockets
#
# CHAOS_SUPPRESS_MEDIA_KEEPALIVE=true
#   → Server terminates ONLY the media connection after ~30s
#   → Triggers Scenario 3: MEDIA_CONNECTION_INTERRUPTED via signaling
#   → App reconnects only the media socket
#
# Set to "true" to activate. Default is "false" (normal operation).
CHAOS_SUPPRESS_SIGNALING_KEEPALIVE=false
CHAOS_SUPPRESS_MEDIA_KEEPALIVE=false

# ============================================================
# Chaos Mode: Force-Disconnect Timer (recommended)
# ============================================================
# Keep-alive suppression only works during silence (keep-alives are
# sent "every 10 seconds when no data is flowing"). When someone is
# actively speaking, the server doesn't send keep-alive pings.
#
# Force-disconnect is more reliable: it closes the socket after N
# seconds regardless of whether data is flowing.
#
# CHAOS_FORCE_DISCONNECT_SIGNALING_AFTER_SEC=15
#   → Forcibly closes the signaling socket 15s after it opens
#   → Server detects the drop, sends meeting.rtms_interrupted
#   → Triggers Scenario 2: app reconnects both sockets
#
# CHAOS_FORCE_DISCONNECT_MEDIA_AFTER_SEC=15
#   → Forcibly closes the media socket 15s after it opens
#   → Server detects the drop, sends MEDIA_CONNECTION_INTERRUPTED
#   → Triggers Scenario 3: app reconnects only the media socket
#
# Set to a number (seconds) to activate. Default is 0 (disabled).
CHAOS_FORCE_DISCONNECT_SIGNALING_AFTER_SEC=0
CHAOS_FORCE_DISCONNECT_MEDIA_AFTER_SEC=0
