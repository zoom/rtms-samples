ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_PATH=/webhook
PORT=3000
access_token="YOUR_ACCESS_TOKEN_HERE"

# Additional runtime configuration
INITIAL_DUPLICATE_SIGNAL_RETRY_DELAY_MS=1500
MAX_DUPLICATE_SIGNAL_RETRIES=3
RTMS_PARTICIPANT_USER_ID="YOUR_RTMS_PARTICIPANT_USER_ID_HERE"
# Optional: comma-separated host suffixes allowed for RTMS signaling/media callbacks (default: zoom.us)
# RTMS_ALLOWED_MEDIA_HOSTS="zoom.us"
