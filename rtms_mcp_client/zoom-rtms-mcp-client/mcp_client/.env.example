PORT=3000
WEBHOOK_PATH="/webhook"
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

ZOOM_SECRET_TOKEN="YOUR_ZOOM_WEBHOOK_SECRET_TOKEN_HERE"
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
ZOOM_ACCOUNT_ID="YOUR_ZOOM_ACCOUNT_ID_HERE"

LLM_MCP_SERVER_URL="http://127.0.0.1:3100/mcp"
LLM_ROUTER_AUTH_TOKEN="YOUR_RANDOM_INTERNAL_SERVICE_TOKEN_HERE"
# Set true only when using plain HTTP over a trusted private container network.
ALLOW_INSECURE_ROUTER_HTTP=false

TRANSCRIPT_BATCH_WINDOW_MS=5000
TRANSCRIPT_BATCH_MAX_CHARACTERS=12000
INITIAL_DUPLICATE_SIGNAL_RETRY_DELAY_MS=1500
MAX_DUPLICATE_SIGNAL_RETRIES=3
