PORT=3100
LLM_ROUTER_AUTH_TOKEN="YOUR_RANDOM_INTERNAL_SERVICE_TOKEN_HERE"
# Logs transcript and model-response content. Keep false outside local debugging.
LOG_CONTENT=false

# Choose anthropic, openai, or openrouter. Only the selected provider's key is required.
AI_PROVIDER="anthropic"
# The selected provider uses its corresponding model. AI_MODEL, when set, overrides it.
AI_MODEL=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_MODEL="gpt-5.6"
OPENROUTER_MODEL="anthropic/claude-sonnet-5"
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY_HERE"
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY_HERE"

# Optional OpenRouter attribution headers and compatible API base URL.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_HTTP_REFERER="https://YOUR_APPLICATION_DOMAIN_HERE"
OPENROUTER_APP_NAME="Zoom RTMS MCP Client"

# Shared controls for every provider.
AI_TASK_PROMPT="Find relevant past meetings and return concise answers with source details."
AI_MAX_OUTPUT_TOKENS=1000
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# Add MCP servers here. Each bearerTokenEnv points to a separate secret below.
# Keep allowedTools explicit. Tools are exposed to the model as <server-id>__<tool-name>.
MCP_SERVERS_JSON='[{"id":"zoom_meeting","url":"https://zoom.us/mcp/meeting/streamable","bearerTokenEnv":"ZOOM_MEETING_MCP_ACCESS_TOKEN","allowedTools":["search_meetings","get_meeting_assets","get_recording_resource","get_file_content","recordings_list"]},{"id":"example_server","url":"https://YOUR_MCP_SERVER_HOST_HERE/mcp","authType":"none","allowedTools":["YOUR_TOOL_NAME_HERE"]}]'
ZOOM_MEETING_MCP_ACCESS_TOKEN="YOUR_ZOOM_USER_OAUTH_ACCESS_TOKEN_HERE"

MAX_TOOL_CALLS_PER_REQUEST=3
MAX_INPUT_CHARACTERS=12000
MAX_TOOL_RESULT_CHARACTERS=50000
