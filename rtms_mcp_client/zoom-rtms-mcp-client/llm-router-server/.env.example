PORT=3100
LLM_ROUTER_AUTH_TOKEN="YOUR_RANDOM_INTERNAL_SERVICE_TOKEN_HERE"
ZOOM_ACCOUNT_ID="YOUR_ZOOM_ACCOUNT_ID_HERE"

ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY_HERE"
ANTHROPIC_MODEL="claude-sonnet-5"
# Optional deployment purpose. The router appends this to its fixed security rules.
ANTHROPIC_TASK_PROMPT="Find relevant past meetings and return concise answers with source details."
ANTHROPIC_MAX_OUTPUT_TOKENS=1000
ANTHROPIC_TIMEOUT_MS=30000
ANTHROPIC_MAX_RETRIES=2

# Add MCP servers here. Each bearerTokenEnv points to a separate secret below.
# Keep allowedTools explicit. Tools are exposed to Claude as <server-id>__<tool-name>.
MCP_SERVERS_JSON='[{"id":"zoom_meeting","url":"https://zoom.us/mcp/meeting/streamable","bearerTokenEnv":"ZOOM_MEETING_MCP_ACCESS_TOKEN","allowedTools":["search_meetings","get_meeting_assets","get_recording_resource","get_file_content","recordings_list"]}]'
ZOOM_MEETING_MCP_ACCESS_TOKEN="YOUR_ZOOM_USER_OAUTH_ACCESS_TOKEN_HERE"

MAX_TOOL_CALLS_PER_REQUEST=3
MAX_INPUT_CHARACTERS=12000
MAX_TOOL_RESULT_CHARACTERS=50000
