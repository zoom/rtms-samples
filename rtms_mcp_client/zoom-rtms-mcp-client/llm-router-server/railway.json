{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "rtms_mcp_client/zoom-rtms-mcp-client/llm-router-server/Dockerfile",
    "watchPatterns": [
      "/rtms_mcp_client/zoom-rtms-mcp-client/llm-router-server/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
