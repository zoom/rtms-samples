# ============================================================================
# Zoom App Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it contains secrets!
# ============================================================================

# ----------------------------------------------------------------------------
# ZOOM APP CREDENTIALS
# ----------------------------------------------------------------------------
# Get these from: https://marketplace.zoom.us/
# Navigate to: Your App → Basic Information → App Credentials
# These identify your app to Zoom's OAuth and API servers

# Your Zoom App's Client ID (required)
# Example: AbC123dEfGhIjKlMnOpQrStU
ZOOM_APP_CLIENT_ID=your_client_id_here

# Your Zoom App's Client Secret (required)
# Keep this secret! Never expose in frontend code or logs
# Example: AbC123dEfGhIjKlMnOpQrStUvWxYz1234567890ab
ZOOM_APP_CLIENT_SECRET=your_client_secret_here

# ----------------------------------------------------------------------------
# PUBLIC URL & OAUTH
# ----------------------------------------------------------------------------
# The public URL where your app is accessible
# For local development: Use your ngrok URL (e.g., https://abc123.ngrok-free.app)
# For production: Use your actual domain (e.g., https://myapp.com)

# Public URL (required)
# This must be HTTPS in production
# Update this whenever your ngrok URL changes
PUBLIC_URL=https://your-ngrok-url.ngrok-free.app

# OAuth Redirect URI (required)
# Where Zoom redirects after user authorizes your app
# Format: {PUBLIC_URL}/api/zoomapp/auth
# This MUST match exactly what's configured in Zoom Marketplace
ZOOM_APP_REDIRECT_URI=https://your-ngrok-url.ngrok-free.app/api/zoomapp/auth

# ----------------------------------------------------------------------------
# SECURITY KEYS
# ----------------------------------------------------------------------------
# Generate strong random strings for these
# NEVER use default values in production!

# Session Secret (required)
# Used to sign session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 characters recommended
SESSION_SECRET=change_this_to_a_random_secret_at_least_32_characters_long

# Redis Encryption Key (required if using Redis)
# Used to encrypt tokens before storing in Redis
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# MUST be exactly 32 characters (16 bytes in hex)
REDIS_ENCRYPTION_KEY=change_this_to_32_char_string

# ----------------------------------------------------------------------------
# DATABASE & CACHING
# ----------------------------------------------------------------------------
# Redis is used for session storage and token caching
# For local development: Optional (falls back to memory store)
# For production: Strongly recommended

# Redis Connection URL (optional for development, required for production)
# Format: redis://[username][:password]@host:port/database
# Local: redis://localhost:6379
# Remote: redis://user:pass@your-redis-host.com:6379
REDIS_URL=redis://localhost:6379

# Redis Password (optional)
# If your Redis instance requires authentication
# REDIS_PASSWORD=your_redis_password

# ----------------------------------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------------------------------
# Port the backend server runs on
# Frontend is served through the backend

# Server Port (optional, defaults to 3000)
PORT=3000

# Node Environment (optional, defaults to 'development')
# Options: 'development', 'production', 'test'
# Affects logging, error messages, and performance optimizations
NODE_ENV=development

# ----------------------------------------------------------------------------
# THIRD-PARTY AUTHENTICATION (OPTIONAL)
# ----------------------------------------------------------------------------
# Only needed if you're using Auth0 or another third-party OAuth provider
# for additional authentication beyond Zoom OAuth

# Auth0 Domain (optional)
# Your Auth0 tenant domain
# Example: myapp.us.auth0.com
# AUTH0_DOMAIN=your-domain.auth0.com

# Auth0 Client ID (optional)
# AUTH0_CLIENT_ID=your_auth0_client_id

# Auth0 Client Secret (optional)
# AUTH0_CLIENT_SECRET=your_auth0_client_secret

# Auth0 Callback URL (optional)
# Where Auth0 redirects after authentication
# AUTH0_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/api/thirdpartyauth/auth0/callback

# ----------------------------------------------------------------------------
# RTMS CONFIGURATION (OPTIONAL)
# ----------------------------------------------------------------------------
# Only needed if you're using Real-Time Media Streams (RTMS)

# Zoom Secret Token (optional, required for RTMS webhooks)
# Used to validate webhook requests from Zoom
# Get from: Zoom Marketplace → Your App → Features → Event Subscriptions
# ZOOM_SECRET_TOKEN=your_webhook_secret_token

# RTMS Webhook Port (optional, defaults to 3002)
# Port for the RTMS webhook server
# RTMS_PORT=3002

# ----------------------------------------------------------------------------
# LOGGING & DEBUGGING (OPTIONAL)
# ----------------------------------------------------------------------------
# Control logging verbosity

# Log Level (optional, defaults to 'info')
# Options: 'error', 'warn', 'info', 'debug', 'trace'
# LOG_LEVEL=info

# Enable Debug Logs (optional, defaults to false)
# Set to 'true' to see detailed request/response logs
# DEBUG=false

# ----------------------------------------------------------------------------
# CORS CONFIGURATION (OPTIONAL)
# ----------------------------------------------------------------------------
# Only needed if frontend is served separately from backend

# CORS Origin (optional)
# Allow frontend to make requests to backend
# Use '*' for development, specific domain for production
# CORS_ORIGIN=https://your-frontend-domain.com

# ----------------------------------------------------------------------------
# PRODUCTION SETTINGS
# ----------------------------------------------------------------------------
# Additional settings for production deployments

# Force HTTPS (optional, recommended for production)
# Redirect all HTTP requests to HTTPS
# FORCE_HTTPS=true

# Trust Proxy (optional, required if behind load balancer)
# Needed for correct IP address detection
# TRUST_PROXY=true

# Session Cookie Domain (optional)
# Restrict session cookies to your domain
# SESSION_COOKIE_DOMAIN=.yourdomain.com

# Session Max Age (optional, defaults to 1 hour)
# How long sessions last in milliseconds
# 1 hour = 3600000
# 1 day = 86400000
# SESSION_MAX_AGE=3600000

# ----------------------------------------------------------------------------
# USAGE NOTES
# ----------------------------------------------------------------------------
#
# REQUIRED VARIABLES FOR BASIC SETUP:
#   - ZOOM_APP_CLIENT_ID
#   - ZOOM_APP_CLIENT_SECRET
#   - PUBLIC_URL
#   - ZOOM_APP_REDIRECT_URI
#   - SESSION_SECRET
#   - REDIS_ENCRYPTION_KEY
#
# LOCAL DEVELOPMENT CHECKLIST:
#   1. Copy this file to .env
#   2. Add your Client ID and Secret from Marketplace
#   3. Start ngrok: ngrok http 3000
#   4. Copy ngrok URL to PUBLIC_URL and ZOOM_APP_REDIRECT_URI
#   5. Generate SESSION_SECRET and REDIS_ENCRYPTION_KEY
#   6. Update Marketplace with your ngrok URLs
#   7. Start your app
#
# PRODUCTION CHECKLIST:
#   1. Use production credentials (not development)
#   2. Set PUBLIC_URL to your actual domain
#   3. Generate new, strong secrets
#   4. Set up Redis with authentication
#   5. Set NODE_ENV=production
#   6. Enable FORCE_HTTPS=true
#   7. Set TRUST_PROXY=true if behind load balancer
#   8. Never commit .env to version control
#   9. Use environment variables in your hosting platform
#
# SECURITY REMINDERS:
#   - Add .env to .gitignore
#   - Never share secrets in Slack, email, or tickets
#   - Rotate secrets regularly
#   - Use different secrets for dev/staging/production
#   - Store production secrets in your hosting platform's secrets manager
#
# HELPFUL COMMANDS:
#   Generate session secret:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#   Generate encryption key:
#     node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
#
#   Test Redis connection:
#     redis-cli ping
#
#   View backend logs:
#     docker-compose logs -f backend
#
# ============================================================================
