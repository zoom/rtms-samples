ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
PORT=3000
WEBHOOK_PATH="/webhook"
FRONTEND_WSS_URL_TO_CONNECT_TO="wss://yoururl.ngrok.com/ws"

# Optional WebSocket pre-RTMS registration controls
FRONTEND_WSS_AUTH_TOKEN=""
ALLOW_PRE_RTMS_REGISTRATION=false

# LLM & Retrieval Configuration
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY_HERE"
MODEL_ID="meta-llama/llama-4-maverick:free"

# Optional dense embeddings (falls back to built-in BM25/TF-IDF hybrid scorer when unset or unavailable)
EMBEDDING_MODEL_ID=""
EMBEDDING_API_URL=""
ENABLE_REMOTE_EMBEDDINGS=true
RAG_MIN_SCORE=0.12
RAG_MIN_QUERY_CHARS=12

# Reject webhook signatures outside this replay window.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
