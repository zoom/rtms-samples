ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
PORT=5050
WEBHOOK_PATH="/webhook"
FRONTEND_WSS_URL_TO_CONNECT_TO=""
MODE="webhook"
zoomWSURLForEvents=""

# Optional Frontend WSS auth settings
FRONTEND_WSS_AUTH_TOKEN=""
FRONTEND_WSS_SIGNING_SECRET=""
ALLOW_PRE_RTMS_REGISTRATION=false

AUDIO_SAMPLE_RATE=48000
TARGET_AUDIO_SAMPLE_RATE=24000
TARGET_CHUNK_DURATION_MS=100

MICROSOFT_VOICE_LIVE_ENABLED=true
MICROSOFT_VOICE_LIVE_ENDPOINT="wss://YOUR_RESOURCE.services.ai.azure.com/voice-live/realtime"
MICROSOFT_VOICE_LIVE_API_VERSION="2026-04-10"
MICROSOFT_VOICE_LIVE_API_KEY="YOUR_MICROSOFT_VOICE_LIVE_API_KEY_HERE"
MICROSOFT_VOICE_LIVE_MODEL="gpt-realtime"
MICROSOFT_TRANSCRIPTION_MODEL="mai-transcribe-2"
MICROSOFT_VOICE_NAME="en-US-Harper:MAI-Voice-2.1-Flash"
MICROSOFT_VOICE_TYPE="azure-standard"
MICROSOFT_INPUT_LANGUAGE="en"
MICROSOFT_VAD_TYPE="azure_semantic_vad"
MICROSOFT_VAD_SILENCE_DURATION_MS=500
MICROSOFT_AUTO_TRUNCATE=true
MICROSOFT_ENABLE_AUDIO_TIMESTAMPS=true
MICROSOFT_MAX_QUEUED_AUDIO_BYTES=2097152
MICROSOFT_RECONNECT_DELAY_MS=2000
MICROSOFT_RESPONSE_NO_OUTPUT_WARNING_MS=8000
MICROSOFT_IGNORE_INTERRUPTS_AFTER_ASSISTANT_AUDIO_START_MS=700
MICROSOFT_SPEAKER_SAFE_TAIL_COOLDOWN_MS=450
MICROSOFT_DEBUG_EVENTS=false

WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
RTMSTRIGGERMANAGERTYPE="webhook"
RTMS_LOGGING="info"
