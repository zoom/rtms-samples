<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OpenAI Realtime Zoom App</title>
  <script src="https://appssdk.zoom.us/sdk.js"></script>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f6f7f9;
      color: #202124;
      height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header {
      background: #ffffff;
      border-bottom: 1px solid #d9dde3;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    h1 {
      font-size: 18px;
      line-height: 1.2;
      margin: 0;
      font-weight: 650;
    }

    .status {
      color: #5f6368;
      font-size: 13px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 48vw;
    }

    main {
      display: grid;
      grid-template-rows: auto 1fr;
      gap: 12px;
      min-height: 0;
      flex: 1;
      padding: 12px;
    }

    .toolbar {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }

    button {
      border: 1px solid #c9d2e3;
      background: #ffffff;
      color: #1f2937;
      border-radius: 6px;
      min-height: 36px;
      padding: 0 12px;
      font: inherit;
      cursor: pointer;
    }

    button.primary {
      background: #2563eb;
      border-color: #2563eb;
      color: #ffffff;
    }

    button.danger {
      color: #b42318;
      border-color: #f2b8b5;
    }

    button:disabled {
      cursor: not-allowed;
      opacity: 0.55;
    }

    .conversation {
      min-height: 0;
      overflow-y: auto;
      background: #ffffff;
      border: 1px solid #d9dde3;
      border-radius: 8px;
      padding: 12px;
    }

    .message {
      display: flex;
      margin-bottom: 10px;
    }

    .message.user {
      justify-content: flex-end;
    }

    .bubble {
      max-width: 82%;
      border-radius: 8px;
      padding: 9px 11px;
      line-height: 1.45;
      font-size: 14px;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .user .bubble {
      background: #2563eb;
      color: #ffffff;
    }

    .assistant .bubble {
      background: #edf2f7;
      color: #202124;
    }

    .note {
      display: block;
      width: fit-content;
      max-width: 100%;
      margin: 6px auto 10px;
      color: #5f6368;
      background: #f1f3f4;
      border: 1px solid #e0e3e7;
      border-radius: 999px;
      padding: 5px 10px;
      font-size: 12px;
    }

    @media (max-width: 640px) {
      header {
        align-items: flex-start;
        flex-direction: column;
      }

      .status {
        max-width: 100%;
      }
    }
  </style>
</head>

<body>
  <header>
    <h1>OpenAI Realtime Zoom App</h1>
    <div id="status" class="status">Connecting...</div>
  </header>

  <main>
    <section class="toolbar">
      <button id="startRtmsBtn" class="primary" type="button">Start RTMS</button>
      <button id="stopRtmsBtn" class="danger" type="button">Stop RTMS</button>
    </section>

    <section id="conversation" class="conversation" aria-live="polite">
      <span class="note">Start RTMS, then speak in the meeting.</span>
    </section>
  </main>

  <script>
    const SERVER_WEBSOCKET_URL = "<%= websocket_url %>";
  </script>
  <script src="audio-client.js"></script>
  <script>
    const statusEl = document.getElementById('status');
    const conversationEl = document.getElementById('conversation');
    const startRtmsBtn = document.getElementById('startRtmsBtn');
    const stopRtmsBtn = document.getElementById('stopRtmsBtn');

    const client = new RealtimeAudioClient(SERVER_WEBSOCKET_URL);
    const zoomState = {
      ready: false,
      meetingUUID: '',
      meetingID: '',
      meetingTopic: '',
      userName: '',
      rtmsState: 'unknown',
    };

    let assistantBubble = null;
    let assistantBuffer = '';

    function setStatus(message) {
      statusEl.textContent = message;
    }

    function addNote(message) {
      const note = document.createElement('span');
      note.className = 'note';
      note.textContent = message;
      conversationEl.appendChild(note);
      conversationEl.scrollTop = conversationEl.scrollHeight;
    }

    function addMessage(text, sender) {
      const wrapper = document.createElement('div');
      wrapper.className = `message ${sender}`;
      const bubble = document.createElement('div');
      bubble.className = 'bubble';
      bubble.textContent = text;
      wrapper.appendChild(bubble);
      conversationEl.appendChild(wrapper);
      conversationEl.scrollTop = conversationEl.scrollHeight;
      return bubble;
    }

    function appendAssistantText(delta) {
      if (!delta) {
        return;
      }

      if (!assistantBubble) {
        assistantBuffer = '';
        assistantBubble = addMessage('', 'assistant');
      }

      assistantBuffer += delta;
      assistantBubble.textContent = assistantBuffer;
      conversationEl.scrollTop = conversationEl.scrollHeight;
    }

    function finishAssistantText(finalText = '') {
      const cleanFinalText = String(finalText || '').trim();
      if (cleanFinalText) {
        if (!assistantBubble) {
          assistantBubble = addMessage(cleanFinalText, 'assistant');
        } else {
          assistantBubble.textContent = cleanFinalText;
        }
      }

      assistantBubble = null;
      assistantBuffer = '';
    }

    function setRtmsState(nextState, rawStatus = null) {
      zoomState.rtmsState = nextState;
      const active = nextState === 'active';
      const pending = nextState === 'starting' || nextState === 'stopping' || nextState === 'checking';
      const unavailable = nextState === 'unavailable';

      startRtmsBtn.disabled = unavailable || pending || active;
      stopRtmsBtn.disabled = unavailable || pending || !active;
      startRtmsBtn.textContent = nextState === 'starting' ? 'Starting...' : 'Start RTMS';
      stopRtmsBtn.textContent = nextState === 'stopping' ? 'Stopping...' : 'Stop RTMS';

      if (rawStatus) {
        console.debug('RTMS status raw:', rawStatus);
      }
    }

    function deriveRtmsState(status) {
      if (Array.isArray(status)) {
        return status.length > 0 ? 'active' : 'inactive';
      }

      const text = JSON.stringify(status || '').toLowerCase();
      if (!text || text === '\"\"') {
        return 'inactive';
      }
      if (text.includes('stopped') || text.includes('inactive') || text.includes('not_started') || text.includes('none')) {
        return 'inactive';
      }
      if (text.includes('active') || text.includes('started') || text.includes('running')) {
        return 'active';
      }
      return 'unknown';
    }

    async function refreshRtmsStatus() {
      if (!zoomState.ready || !window.zoomSdk?.getRTMSStatus) {
        setRtmsState(zoomState.ready ? 'unknown' : 'unavailable');
        return;
      }

      setRtmsState('checking');
      try {
        const rtmsStatus = await window.zoomSdk.getRTMSStatus();
        const nextState = deriveRtmsState(rtmsStatus);
        setRtmsState(nextState, rtmsStatus);
        setStatus(nextState === 'active' ? 'RTMS active' : 'RTMS inactive');
      } catch (error) {
        console.error('Failed to get RTMS status:', error);
        setRtmsState('unknown');
        setStatus('RTMS status unavailable');
      }
    }

    async function initializeZoomSdk() {
      const sdk = window.zoomSdk;
      if (!sdk) {
        setStatus('Open this page inside Zoom to use Zoom App controls.');
        startRtmsBtn.disabled = true;
        stopRtmsBtn.disabled = true;
        return;
      }

      try {
        await sdk.config({
          version: '0.16.31',
          capabilities: [
            'getSupportedJsApis',
            'getRunningContext',
            'getMeetingContext',
            'getUserContext',
            'getMeetingUUID',
            'getAppContext',
            'startRTMS',
            'stopRTMS',
            'getRTMSStatus',
            'onRTMSStatusChange',
          ],
        });

        const [runningContext, meetingContext, userContext, meetingUUID] = await Promise.all([
          sdk.getRunningContext(),
          sdk.getMeetingContext(),
          sdk.getUserContext(),
          sdk.getMeetingUUID(),
        ]);

        zoomState.ready = true;
        zoomState.meetingUUID = meetingUUID?.meetingUUID || '';
        zoomState.meetingID = meetingContext?.meetingID || '';
        zoomState.meetingTopic = meetingContext?.meetingTopic || '';
        zoomState.userName = userContext?.screenName || userContext?.displayName || '';

        client.sendReady({
          meeting_uuid: zoomState.meetingUUID,
          meeting_id: zoomState.meetingID,
          topic: zoomState.meetingTopic,
          user_name: zoomState.userName,
          running_context: runningContext?.context || '',
        });

        const handleRtmsStatusChange = (event) => {
          const nextState = deriveRtmsState(event);
          setRtmsState(nextState, event);
          setStatus(nextState === 'active' ? 'RTMS active' : 'RTMS inactive');
          addNote(`RTMS status: ${event?.status || JSON.stringify(event)}`);
        };

        if (typeof sdk.onRTMSStatusChange === 'function') {
          sdk.onRTMSStatusChange(handleRtmsStatusChange);
        } else if (typeof sdk.on === 'function') {
          sdk.on('onRTMSStatusChange', handleRtmsStatusChange);
        }

        setStatus('Zoom App ready');
        await refreshRtmsStatus();
      } catch (error) {
        console.error('Zoom SDK initialization failed:', error);
        setStatus('Zoom SDK unavailable or missing capabilities');
        setRtmsState('unavailable');
      }
    }

    startRtmsBtn.addEventListener('click', async () => {
      try {
        setRtmsState('starting');
        await client.enablePlayback();
        await window.zoomSdk.startRTMS();
        addNote('Requested RTMS start');
        await refreshRtmsStatus();
      } catch (error) {
        await refreshRtmsStatus();
        addNote(`Failed to start RTMS: ${error.message || error}`);
      }
    });

    stopRtmsBtn.addEventListener('click', async () => {
      try {
        setRtmsState('stopping');
        await window.zoomSdk.stopRTMS();
        client.interrupt(true);
        addNote('Requested RTMS stop');
        await refreshRtmsStatus();
      } catch (error) {
        await refreshRtmsStatus();
        addNote(`Failed to stop RTMS: ${error.message || error}`);
      }
    });

    client.onReady = () => {
      setStatus('Frontend WebSocket connected');
      setRtmsState('unavailable');
      initializeZoomSdk();
    };

    client.onStatus = (message) => {
      setStatus(message);
      addNote(message);
    };

    client.onTranscript = (text) => {
      if (text.trim()) {
        addMessage(text, 'user');
      }
    };

    client.onTextDelta = (delta) => {
      appendAssistantText(delta);
    };

    client.onTextDone = (text) => {
      finishAssistantText(text);
    };

    client.onAudioStart = () => {
      setStatus('Assistant speaking...');
    };

    client.onAudioDone = () => {
      setStatus('Assistant finished speaking');
    };

    client.onInterrupted = () => {
      finishAssistantText();
      addNote('Assistant interrupted by new speech');
      setStatus('Interrupted');
    };

    client.onError = (message) => {
      addNote(`Error: ${message}`);
      setStatus('Error');
    };

    window.addEventListener('load', async () => {
      try {
        await client.connect();
      } catch (error) {
        client.onError(error.message || String(error));
      }
    });

    window.addEventListener('beforeunload', () => {
      client.close();
    });
  </script>
</body>

</html>
