<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Voice Chat (RTMS)</title>
  <script src="https://appssdk.zoom.us/sdk.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #f8fafc;
      --surface: #ffffff;
      --surface-alt: #f1f5f9;
      --border: #cbd5e1;
      --text: #0f172a;
      --muted: #475569;
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --danger: #dc2626;
      --success: #16a34a;
      --warn: #d97706;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0.75rem 1rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
      justify-content: space-between;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 700;
      font-size: 1rem;
    }
    .badge {
      font-size: 0.72rem;
      font-weight: 600;
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
      background: var(--surface-alt);
      color: var(--muted);
      border: 1px solid var(--border);
    }
    .badge.ok { background: #dcfce7; color: #166534; border-color: #86efac; }
    .badge.warn { background: #fef3c7; color: #92400e; border-color: #fcd34d; }
    .badge.err { background: #fee2e2; color: #991b1b; border-color: #fca5a5; }
    .controls-bar {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0.6rem 1rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
    }
    button, select, input[type="text"] {
      font-family: inherit;
      font-size: 0.8rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      padding: 0.4rem 0.7rem;
      background: var(--surface);
      color: var(--text);
    }
    button {
      cursor: pointer;
      font-weight: 600;
      transition: background 0.15s;
    }
    button:hover { background: var(--surface-alt); }
    button.primary { background: var(--primary); color: #fff; border-color: var(--primary); }
    button.primary:hover { background: var(--primary-hover); }
    button.danger { background: var(--danger); color: #fff; border-color: var(--danger); }
    button.success { background: var(--success); color: #fff; border-color: var(--success); }
    button.warn { background: var(--warn); color: #fff; border-color: var(--warn); }
    button:disabled { opacity: 0.5; cursor: not-allowed; }
    .control-group {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .control-label {
      font-size: 0.75rem;
      color: var(--muted);
      font-weight: 600;
    }
    main {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      padding: 0.75rem 1rem;
      gap: 0.6rem;
    }
    .status-strip {
      font-size: 0.78rem;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .transcript-container {
      flex: 1;
      overflow-y: auto;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 0.9rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .placeholder {
      color: var(--muted);
      text-align: center;
      margin: auto;
      font-size: 0.9rem;
    }
    .message-row {
      display: flex;
      flex-direction: column;
      max-width: 82%;
    }
    .message-row.user { align-self: flex-end; align-items: flex-end; }
    .message-row.assistant { align-self: flex-start; align-items: flex-start; }
    .message-row.system { align-self: center; align-items: center; max-width: 95%; }
    .message-meta {
      font-size: 0.7rem;
      color: var(--muted);
      margin-bottom: 0.2rem;
    }
    .bubble {
      padding: 0.6rem 0.85rem;
      border-radius: 12px;
      font-size: 0.88rem;
      line-height: 1.45;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .message-row.user .bubble {
      background: var(--primary);
      color: #fff;
      border-bottom-right-radius: 4px;
    }
    .message-row.user.suppressed .bubble {
      background: #e2e8f0;
      color: var(--muted);
    }
    .message-row.assistant .bubble {
      background: var(--surface-alt);
      color: var(--text);
      border: 1px solid var(--border);
      border-bottom-left-radius: 4px;
    }
    .message-row.system .bubble {
      background: #fef3c7;
      color: #92400e;
      font-size: 0.78rem;
      border: 1px solid #fcd34d;
    }
    .composer {
      display: flex;
      gap: 0.5rem;
      align-items: flex-end;
    }
    .composer textarea {
      flex: 1;
      resize: none;
      min-height: 44px;
      max-height: 110px;
      padding: 0.6rem 0.75rem;
      border-radius: 10px;
      border: 1px solid var(--border);
      font-family: inherit;
      font-size: 0.88rem;
    }
    .composer textarea:focus {
      outline: none;
      border-color: var(--primary);
    }
    .hidden { display: none !important; }
  </style>
</head>

<body>
  <header>
    <div class="brand">
      <span>AI Voice Chat</span>
      <span id="ws-badge" class="badge">Connecting...</span>
      <span id="rtms-badge" class="badge">RTMS: Idle</span>
    </div>
    <div class="control-group">
      <button id="btn-start-rtms" class="primary">Start RTMS</button>
      <button id="btn-stop-rtms">Stop RTMS</button>
    </div>
  </header>

  <div class="controls-bar">
    <div class="control-group">
      <button id="btn-audio-toggle" class="success">Enable Audio</button>
      <button id="btn-interrupt" class="danger" disabled>Interrupt / Stop</button>
    </div>

    <div class="control-group">
      <span class="control-label">Trigger:</span>
      <select id="select-mode">
        <option value="wake_word">Wake-Word (Safe)</option>
        <option value="push_to_talk">Push-to-Talk</option>
        <option value="auto">Auto-Reply</option>
      </select>
    </div>

    <div id="wake-word-group" class="control-group">
      <span class="control-label">Wake Words:</span>
      <input id="input-wake-words" type="text" value="hey ai, okay ai, assistant" style="width: 170px;" />
      <button id="btn-save-wake">Apply</button>
    </div>

    <div id="ptt-group" class="control-group hidden">
      <button id="btn-arm-ptt" class="warn">Arm Next Spoken Turn</button>
    </div>
  </div>

  <main>
    <div class="status-strip">
      <span id="assistant-status">Say "Hey AI ..." or type a message below. Click "Enable Audio" to hear spoken replies.</span>
      <span id="speaking-indicator"></span>
    </div>

    <div id="transcript" class="transcript-container">
      <div class="placeholder">Waiting for speech or typed prompt...</div>
    </div>

    <div class="composer">
      <textarea id="text-input" placeholder="Type a prompt and press Enter..."></textarea>
      <button id="btn-send" class="primary" style="height: 44px;">Send</button>
    </div>
  </main>

  <script>
    const SERVER_WEBSOCKET_URL = <%- JSON.stringify(websocketUrl).replace(/</g, '\\u003c') %>;
    const WS_AUTH_TOKEN = <%- JSON.stringify(typeof wsAuthToken === 'string' ? wsAuthToken : '').replace(/</g, '\\u003c') %>;
  </script>
  <script src="audio-client.js"></script>
  <script>
    (function () {
      const client = new AudioClient(SERVER_WEBSOCKET_URL);
      const wsBadge = document.getElementById('ws-badge');
      const rtmsBadge = document.getElementById('rtms-badge');
      const assistantStatusEl = document.getElementById('assistant-status');
      const speakingIndicatorEl = document.getElementById('speaking-indicator');
      const transcriptEl = document.getElementById('transcript');
      const textInput = document.getElementById('text-input');
      const btnSend = document.getElementById('btn-send');
      const btnStartRtms = document.getElementById('btn-start-rtms');
      const btnStopRtms = document.getElementById('btn-stop-rtms');
      const btnAudioToggle = document.getElementById('btn-audio-toggle');
      const btnInterrupt = document.getElementById('btn-interrupt');
      const selectMode = document.getElementById('select-mode');
      const wakeWordGroup = document.getElementById('wake-word-group');
      const inputWakeWords = document.getElementById('input-wake-words');
      const btnSaveWake = document.getElementById('btn-save-wake');
      const pttGroup = document.getElementById('ptt-group');
      const btnArmPtt = document.getElementById('btn-arm-ptt');

      const sentenceNodes = new Map();
      let currentUserName = 'Participant';
      let currentMode = 'wake_word';
      let pttArmed = false;
      let zoomReady = false;

      function setBadge(el, text, kind) {
        el.textContent = text;
        el.className = 'badge' + (kind ? ' ' + kind : '');
      }

      function removePlaceholder() {
        const placeholder = transcriptEl.querySelector('.placeholder');
        if (placeholder) placeholder.remove();
      }

      function formatTime(ts) {
        try {
          return new Date(ts || Date.now()).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        } catch {
          return '';
        }
      }

      function appendMessage({ role, speaker, text, timestamp, sentenceKey, suppressedReason }) {
        if (!text) return;
        removePlaceholder();

        if (sentenceKey && sentenceNodes.has(sentenceKey)) {
          const existing = sentenceNodes.get(sentenceKey);
          existing.bubble.textContent = text;
          existing.meta.textContent = `${speaker || 'Speaker'} · ${formatTime(timestamp)}${suppressedReason ? ' (' + suppressedReason.replace(/_/g, ' ') + ')' : ''}`;
          existing.row.classList.toggle('suppressed', Boolean(suppressedReason));
          transcriptEl.scrollTop = transcriptEl.scrollHeight;
          return;
        }

        const row = document.createElement('div');
        row.className = `message-row ${role}${suppressedReason ? ' suppressed' : ''}`;

        if (role !== 'system') {
          const meta = document.createElement('div');
          meta.className = 'message-meta';
          const suffix = suppressedReason ? ` (${suppressedReason.replace(/_/g, ' ')})` : '';
          meta.textContent = `${speaker || (role === 'assistant' ? 'AI Assistant' : 'Participant')} · ${formatTime(timestamp)}${suffix}`;
          row.appendChild(meta);

          const bubble = document.createElement('div');
          bubble.className = 'bubble';
          bubble.textContent = text;
          row.appendChild(bubble);

          if (sentenceKey) {
            sentenceNodes.set(sentenceKey, { row, meta, bubble });
          }
        } else {
          const bubble = document.createElement('div');
          bubble.className = 'bubble';
          bubble.textContent = text;
          row.appendChild(bubble);
        }

        transcriptEl.appendChild(row);
        transcriptEl.scrollTop = transcriptEl.scrollHeight;
      }

      function syncModeUi(state) {
        if (!state) return;
        currentMode = state.mode || 'wake_word';
        pttArmed = Boolean(state.pttArmed);
        selectMode.value = currentMode;

        if (Array.isArray(state.wakeWords) && state.wakeWords.length > 0) {
          inputWakeWords.value = state.wakeWords.join(', ');
        }

        wakeWordGroup.classList.toggle('hidden', currentMode !== 'wake_word');
        pttGroup.classList.toggle('hidden', currentMode !== 'push_to_talk');
        btnArmPtt.textContent = pttArmed ? 'Armed — Speak Now!' : 'Arm Next Spoken Turn';
        btnArmPtt.className = pttArmed ? 'success' : 'warn';

        if (currentMode === 'wake_word') {
          assistantStatusEl.textContent = `Wake-word mode active (${inputWakeWords.value}). Echo suppression enabled.`;
        } else if (currentMode === 'push_to_talk') {
          assistantStatusEl.textContent = pttArmed
            ? 'Push-to-Talk armed: your next spoken sentence will trigger the AI.'
            : 'Push-to-Talk mode: click "Arm Next Spoken Turn" or type below.';
        } else {
          assistantStatusEl.textContent = 'Auto-Reply mode active (echo & cooldown suppression enabled).';
        }
      }

      function updateAudioButton() {
        if (!client.audioUnlocked) {
          btnAudioToggle.textContent = 'Enable Audio';
          btnAudioToggle.className = 'success';
        } else if (client.isMuted) {
          btnAudioToggle.textContent = 'Unmute Audio';
          btnAudioToggle.className = 'warn';
        } else {
          btnAudioToggle.textContent = 'Mute Audio';
          btnAudioToggle.className = '';
        }
      }

      btnAudioToggle.addEventListener('click', async () => {
        if (!client.audioUnlocked) {
          await client.unlockAudio();
          client.setMuted(false);
        } else {
          client.setMuted(!client.isMuted);
        }
        updateAudioButton();
      });

      btnInterrupt.addEventListener('click', () => {
        client.interrupt();
        assistantStatusEl.textContent = 'Playback interrupted.';
      });

      selectMode.addEventListener('change', () => {
        client.sendSettings({ mode: selectMode.value });
      });

      btnSaveWake.addEventListener('click', () => {
        client.sendSettings({ mode: 'wake_word', wakeWords: inputWakeWords.value });
      });

      btnArmPtt.addEventListener('click', () => {
        client.sendSettings({ mode: 'push_to_talk', pttArmed: !pttArmed });
      });

      function sendTyped() {
        const text = textInput.value.trim();
        if (!text) return;
        if (!client.isRegistered) {
          appendMessage({ role: 'system', text: 'Not connected to meeting session yet.' });
          return;
        }
        client.sendText(text, currentUserName);
        textInput.value = '';
      }

      btnSend.addEventListener('click', sendTyped);
      textInput.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && !event.shiftKey) {
          event.preventDefault();
          sendTyped();
        }
      });

      btnStartRtms.addEventListener('click', async () => {
        if (!zoomReady || typeof zoomSdk === 'undefined') {
          appendMessage({ role: 'system', text: 'Open this app inside a Zoom meeting to start RTMS.' });
          return;
        }
        try {
          await zoomSdk.startRTMS();
          setBadge(rtmsBadge, 'RTMS: Starting...', 'warn');
        } catch (err) {
          appendMessage({ role: 'system', text: `Start RTMS failed: ${err?.message || err}` });
        }
      });

      btnStopRtms.addEventListener('click', async () => {
        if (!zoomReady || typeof zoomSdk === 'undefined') return;
        try {
          await zoomSdk.stopRTMS();
          setBadge(rtmsBadge, 'RTMS: Stopping...', 'warn');
        } catch (err) {
          appendMessage({ role: 'system', text: `Stop RTMS failed: ${err?.message || err}` });
        }
      });

      client.onConnected = () => setBadge(wsBadge, 'Authenticating...', 'warn');
      client.onDisconnected = () => setBadge(wsBadge, 'Reconnecting...', 'err');
      client.onRegistered = () => setBadge(wsBadge, 'Connected', 'ok');

      client.onStateReceived = (state) => {
        syncModeUi(state);
        if (Array.isArray(state?.messages) && transcriptEl.querySelector('.placeholder') && state.messages.length > 0) {
          state.messages.forEach((m) => appendMessage(m));
        }
      };

      client.onTranscriptReceived = (payload) => {
        if (!payload?.message) return;
        appendMessage({
          role: 'user',
          speaker: payload.message.speaker,
          text: payload.message.text,
          timestamp: payload.message.timestamp,
          sentenceKey: payload.sentenceKey,
          suppressedReason: payload.willReply ? null : payload.suppressedReason
        });
      };

      client.onUserMessageReceived = (msg) => {
        appendMessage({
          role: 'user',
          speaker: msg.speaker,
          text: msg.text,
          timestamp: msg.timestamp
        });
      };

      client.onTextReceived = (text, metadata) => {
        appendMessage({
          role: 'assistant',
          speaker: 'AI Assistant',
          text,
          timestamp: metadata.timestamp || Date.now()
        });
      };

      client.onStatusChange = (msg) => {
        if (msg.type === 'rtms_status') {
          if (msg.status === 'started') setBadge(rtmsBadge, 'RTMS: Live', 'ok');
          if (msg.status === 'stopped') setBadge(rtmsBadge, 'RTMS: Stopped', '');
          return;
        }
        if (msg.status === 'thinking') {
          assistantStatusEl.textContent = 'AI is thinking...';
          btnInterrupt.disabled = false;
        } else if (msg.status === 'tts_unavailable') {
          assistantStatusEl.textContent = msg.message || 'Audio synthesis unavailable.';
        } else if (msg.status === 'idle' && !client.isModelSpeaking) {
          btnInterrupt.disabled = true;
          syncModeUi({ mode: currentMode, pttArmed });
        }
      };

      client.onSpeakingChange = (speaking) => {
        speakingIndicatorEl.textContent = speaking ? '🔊 Speaking...' : '';
        btnInterrupt.disabled = !speaking;
      };

      client.onInterrupted = () => {
        speakingIndicatorEl.textContent = '';
        btnInterrupt.disabled = true;
      };

      client.onError = (message) => {
        appendMessage({ role: 'system', text: String(message || 'Connection error') });
      };

      async function initZoomAndConnect() {
        let meetingUUID = '';
        let userID = '';

        if (typeof zoomSdk !== 'undefined') {
          try {
            await zoomSdk.config({
              version: '0.16.31',
              capabilities: [
                'getMeetingContext',
                'getUserContext',
                'getMeetingUUID',
                'startRTMS',
                'stopRTMS',
                'onRTMSStatusChange'
              ]
            });
            zoomReady = true;

            const [meetingUuidRes, userCtxRes] = await Promise.all([
              zoomSdk.getMeetingUUID().catch(() => null),
              zoomSdk.getUserContext().catch(() => null)
            ]);

            meetingUUID = meetingUuidRes?.meetingUUID || '';
            userID = userCtxRes?.participantUUID || userCtxRes?.participantId || '';
            currentUserName = userCtxRes?.screenName || 'Participant';

            if (typeof zoomSdk.onRTMSStatusChange === 'function') {
              zoomSdk.onRTMSStatusChange((event) => {
                const status = event?.status || event?.state || 'Updated';
                setBadge(rtmsBadge, `RTMS: ${status}`, status === 'started' ? 'ok' : 'warn');
              });
            }
          } catch (err) {
            console.warn('[ZoomSDK] Running outside Zoom client or SDK config failed:', err);
          }
        }

        // Dev fallback via URL query params (?meetingUUID=...&userID=...)
        const params = new URLSearchParams(window.location.search);
        if (!meetingUUID) meetingUUID = params.get('meetingUUID') || 'local-dev-meeting';
        if (!userID) userID = params.get('userID') || 'local-dev-user';

        client.setRegistration({
          meetingUUID,
          userID,
          token: WS_AUTH_TOKEN
        });

        try {
          await client.connect();
        } catch (err) {
          console.error('[AudioClient] Initial connect failed; will auto-reconnect:', err);
        }
      }

      window.addEventListener('load', () => {
        updateAudioButton();
        initZoomAndConnect();
      });

      window.addEventListener('beforeunload', () => {
        client.close();
      });
    })();
  </script>
</body>

</html>
