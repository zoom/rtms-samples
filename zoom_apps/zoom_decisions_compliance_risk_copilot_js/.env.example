# Zoom Marketplace app credentials and webhook verification token.
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"

# Web server and public Zoom App URL.
PORT=3000
PUBLIC_BASE_URL="https://YOUR_DOMAIN_HERE"
WEBHOOK_PATH="/webhook"
FRONTEND_WSS_URL_TO_CONNECT_TO="wss://YOUR_DOMAIN_HERE/ws"
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Zoom AI Services API key used server-side for the Zoom Decisions API.
ZOOM_AI_SERVICES_API_KEY="YOUR_ZOOM_AI_SERVICES_API_KEY_HERE"
ZOOM_DECISIONS_URL="https://api.zoom.us/v2/aiservices/decisions/decide"
ZOOM_DECISIONS_MODEL="zoom-decisions"
ZOOM_DECISIONS_TIMEOUT_MS=10000
COMPLIANCE_HISTORY_TURNS=12
COMPLIANCE_MIN_TRANSCRIPT_CHARACTERS=8

# Describe the regulated conversation, product, and rules Zoom Decisions should evaluate.
COMPLIANCE_CONTEXT="Regulated consumer finance support call"
