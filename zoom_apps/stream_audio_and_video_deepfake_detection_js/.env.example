PORT=5050
PUBLIC_BASE_URL=""
WEBHOOK_PATH=/webhook

# Zoom RTMS app credentials. The Zoom App frontend starts/stops RTMS by SDK capability;
# these credentials are used by RTMSManager after meeting.rtms_started arrives.
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"

# RTMS media settings
MEDIA_SOCKET_CONNECTION_MODE=split
MEDIA_TYPES_FLAG=3
VIDEO_STREAM_MODE=individual
AUDIO_STREAM_MODE=multi
ALLOW_MANUAL_RTMS_USER_ID="YOUR_ALLOW_MANUAL_RTMS_USER_ID_HERE"
VIDEO_RESOLUTION=HD
VIDEO_FPS=25
AUDIO_SEND_RATE=100

# Playback/transcoding
ENABLE_HLS_PREVIEW=true
FFMPEG_PATH=ffmpeg
FFMPEG_THREAD_QUEUE_SIZE=1024
HLS_SEGMENT_SECONDS=2
HLS_LIST_SIZE=6

# Deepfake detection
# service = POST sampled video clips to DEEPFAKE_SERVICE_URL
#           the URL may be either the base host (http://127.0.0.1:8012 or https://your-deepfake-service.example.com)
#           or the full raw-video endpoint (.../video/classify)
#           optional manual multipart upload endpoint: DEEPFAKE_UPLOAD_URL (.../video/upload)
# local_cli = run classify_clip.py per sampled clip
# off = disable inference
DEEPFAKE_MODE=service
DEEPFAKE_MODEL_NAME=Naman712/Deep-fake-detection
DEEPFAKE_SERVICE_URL="http://127.0.0.1:8012/video/classify"
DEEPFAKE_UPLOAD_URL="YOUR_DEEPFAKE_UPLOAD_URL_HERE"
DEEPFAKE_API_KEY="YOUR_DEEPFAKE_API_KEY_HERE"
DEEPFAKE_FRAME_FPS=5
DEEPFAKE_CLIP_SECONDS=2
DEEPFAKE_CLIP_STABLE_AGE_MS=1500
DEEPFAKE_MIN_CLIP_BYTES=4096
DEEPFAKE_INFERENCE_LOG_LEVEL=info
# Legacy fallback if DEEPFAKE_FRAME_FPS is unset:
# DEEPFAKE_SAMPLE_INTERVAL_MS=3000
DEEPFAKE_REAL_THRESHOLD=0.75
DEEPFAKE_VENDOR_NAME=Naman712/Deep-fake-detection
PYTHON_BIN=python3

# Audio deepfake verification
# This is a separate service from video verification. It receives selected-user raw PCM audio windows.
# service = POST raw PCM L16 clips to AUDIO_DEEPFAKE_SERVICE_URL with the required DEEPFAKE_API_KEY bearer key.
# off = hide/disable audio inference backend calls while keeping RTMS individual audio enabled
AUDIO_DEEPFAKE_MODE=service
AUDIO_DEEPFAKE_MODEL_NAME=MelodyMachine/Deepfake-audio-detection-V2
AUDIO_DEEPFAKE_SERVICE_URL="YOUR_AUDIO_DEEPFAKE_SERVICE_URL_HERE"
AUDIO_DEEPFAKE_CLIP_SECONDS=4
AUDIO_DEEPFAKE_MAX_CLIPS=24
AUDIO_DEEPFAKE_MIN_RMS_DBFS=-65
AUDIO_DEEPFAKE_REAL_THRESHOLD=0.75
AUDIO_DEEPFAKE_VENDOR_NAME=MelodyMachine/Deepfake-audio-detection-V2

# Zoom Apps Layers overlay
ENABLE_LAYERS_OVERLAY=true
OVERLAY_LABEL_PREFIX=Verified by

LOG_LEVEL=debug

# Reject webhook signatures outside this replay window.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Additional runtime configuration
AUDIO_DEEPFAKE_UPLOAD_URL=""
DEEPFAKE_VIDEO_UPLOAD_URL=""

# Additional runtime configuration
DEEPFAKE_SAMPLE_INTERVAL_MS=3000
