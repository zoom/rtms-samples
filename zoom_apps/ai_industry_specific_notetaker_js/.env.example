ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
PORT=3000
WEBHOOK_PATH="/webhook"
FRONTEND_WSS_URL_TO_CONNECT_TO="wss://yoururl.ngrok.com/ws"

OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY_HERE"
# Model configs (Free-tier models)
NER_MODEL=mistralai/mistral-7b-instruct
SUMMARY_MODEL=mistralai/mistral-7b-instruct
TOPIC_MODEL=mistralai/mistral-7b-instruct


#non free model
EMBEDDING_MODEL=openai/text-embedding-ada-002

# Reject webhook signatures outside this replay window.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
