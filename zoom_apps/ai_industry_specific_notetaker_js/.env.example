ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
PORT=3000
WEBHOOK_PATH="/webhook"
# Optional: leave blank to auto-detect ws:// or wss:// from request host
FRONTEND_WSS_URL_TO_CONNECT_TO=""

OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY_HERE"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Default industry template:
# general | healthcare_soap | legal_compliance | sales_meddic | finance_advisory | engineering_rfc
DEFAULT_INDUSTRY_TEMPLATE="general"
NOTETAKER_BATCH_SIZE=3
NOTETAKER_BATCH_DELAY_MS=4000

# Optional shared token for frontend WS auth or local dev pre-RTMS registration
# FRONTEND_WSS_AUTH_TOKEN=""
# ALLOW_PRE_RTMS_REGISTRATION="false"

# Reject webhook signatures outside this replay window.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
