ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
PORT=3000
WEBHOOK_PATH="/webhook"

# Optional override; leave blank to auto-derive ws:// or wss:// from the request host.
WS_URL=""

# Event delivery mode: "webhook" or "websocket"
MODE="webhook"
zoomWSURLForEvents=""

# Optional shared token for frontend WebSocket registration (in addition to active RTMS / x-zoom-app-context).
FRONTEND_WSS_AUTH_TOKEN=""

# Set to true only for local development when registering before RTMS starts without Zoom context headers.
ALLOW_PRE_RTMS_REGISTRATION=false

# Reject webhook signatures outside this replay window.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
