ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
PORT=3000
WEBHOOK_PATH="/webhook"

OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=512
OPENAI_MAX_INPUT_CHARACTERS=12000
OPENAI_MAX_REQUESTS_PER_MINUTE=30
OPENAI_MAX_REQUESTS_PER_STREAM=300
OPENAI_MAX_SPEND_USD_PER_STREAM=1
# Keep these prices aligned with OPENAI_MODEL for local spend estimation.
OPENAI_INPUT_COST_PER_MILLION_TOKENS=0.4
OPENAI_OUTPUT_COST_PER_MILLION_TOKENS=1.6

# Reject webhook signatures outside this replay window.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Additional runtime configuration
MEDIA_SOCKET_CONNECTION_MODE="split"
