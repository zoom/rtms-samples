ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
PORT=3000
WEBHOOK_PATH="/webhook"

ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY_HERE"
CLAUDE_MODEL="claude-sonnet-5"
CLAUDE_TIMEOUT_MS=20000
CLAUDE_MAX_RETRIES=2
CLAUDE_MAX_OUTPUT_TOKENS=512
CLAUDE_MAX_INPUT_CHARACTERS=40000
CLAUDE_MAX_HISTORY_MESSAGES=20
CLAUDE_MAX_HISTORY_CHARACTERS=40000
CLAUDE_MAX_REQUESTS_PER_MINUTE=30
CLAUDE_MAX_REQUESTS_PER_STREAM=300
CLAUDE_MAX_SPEND_USD_PER_STREAM=1
# Keep these prices aligned with CLAUDE_MODEL for local spend estimation.
CLAUDE_INPUT_COST_PER_MILLION_TOKENS=2
CLAUDE_OUTPUT_COST_PER_MILLION_TOKENS=10

# Reject webhook signatures outside this replay window.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Additional runtime configuration
MEDIA_SOCKET_CONNECTION_MODE="split"
