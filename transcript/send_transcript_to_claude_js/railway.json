{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "transcript/send_transcript_to_claude_js/Dockerfile",
    "watchPatterns": [
      "/transcript/send_transcript_to_claude_js/**",
      "/library/javascript/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
