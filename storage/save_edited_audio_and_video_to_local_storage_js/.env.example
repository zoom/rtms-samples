# Zoom RTMS webhook and credentials
ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
PORT=3000
WEBHOOK_PATH="/webhook"
RTMSTRIGGERMANAGERTYPE="webhook"
zoomWSURLForEvents=""

# Optional Server-to-Server OAuth credentials for WebSocket event triggering
ZOOM_S2S_CLIENT_ID="YOUR_ZOOM_S2S_CLIENT_ID_HERE"
ZOOM_S2S_CLIENT_SECRET="YOUR_ZOOM_S2S_CLIENT_SECRET_HERE"
ZOOM_ACCOUNT_ID="YOUR_ZOOM_ACCOUNT_ID_HERE"

# Optional Video SDK credentials when processing Video SDK RTMS streams
VIDEO_CLIENT_ID="YOUR_VIDEO_CLIENT_ID_HERE"
VIDEO_CLIENT_SECRET="YOUR_VIDEO_CLIENT_SECRET_HERE"
VIDEO_SECRET_TOKEN="YOUR_VIDEO_SECRET_TOKEN_HERE"

# RTMS processing
LOG_LEVEL="info"
MEDIA_SOCKET_CONNECTION_MODE="split"
MEDIA_TYPES_FLAG=11

# OpenAI-compatible Chat Completions endpoint used only to generate an edit plan
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_API_KEY="YOUR_AI_API_KEY_HERE"
AI_MODEL="gpt-5.6-terra"
AI_MIN_SEGMENT_MS=800
AI_MAX_OUTPUT_SECONDS=300

# Keep false until you have reviewed generated plans manually
AI_AUTO_EDIT_ON_STOP=false
AI_DEFAULT_EDITING_BRIEF="Create a concise meeting highlight video with clear context."
