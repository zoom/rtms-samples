ZOOM_SECRET_TOKEN="xxxxx"
ZOOM_CLIENT_ID="xxxxx"
ZOOM_CLIENT_SECRET="xxxxx"
PORT=3000
WEBHOOK_PATH="/webhook"

RTMSTRIGGERMANAGERTYPE="webhook"
zoomWSURLForEvents="wss://ws.zoom.us/ws?subscriptionId=xxxxx"

ZOOM_S2S_CLIENT_ID="xxxxx"
ZOOM_S2S_CLIENT_SECRET="xxxxx"
ZOOM_ACCOUNT_ID="xxxxx"

VIDEO_CLIENT_ID="xxxxx"
VIDEO_CLIENT_SECRET="xxxxx"
VIDEO_SECRET_TOKEN="xxxxx"

MEDIA_SOCKET_CONNECTION_MODE="split"
MEDIA_TYPES_FLAG=11

# OpenAI Chat Completions endpoint used only to generate an edit plan.
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_API_KEY="replace_with_your_openai_api_key"
AI_MODEL="gpt-5.6-terra"
AI_MIN_SEGMENT_MS=800
AI_MAX_OUTPUT_SECONDS=300

# Keep false until you have reviewed generated plans manually.
AI_AUTO_EDIT_ON_STOP=false
AI_DEFAULT_EDITING_BRIEF="Create a concise meeting highlight video with clear context."
