ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
PORT=3000
WEBHOOK_PATH="/webhook"

RTMSTRIGGERMANAGERTYPE="webhook"
zoomWSURLForEvents=""

ZOOM_S2S_CLIENT_ID="YOUR_ZOOM_S2S_CLIENT_ID_HERE"
ZOOM_S2S_CLIENT_SECRET="YOUR_ZOOM_S2S_CLIENT_SECRET_HERE"
ZOOM_ACCOUNT_ID="YOUR_ZOOM_ACCOUNT_ID_HERE"

VIDEO_CLIENT_ID="YOUR_VIDEO_CLIENT_ID_HERE"
VIDEO_CLIENT_SECRET="YOUR_VIDEO_CLIENT_SECRET_HERE"
VIDEO_SECRET_TOKEN="YOUR_VIDEO_SECRET_TOKEN_HERE"

MEDIA_SOCKET_CONNECTION_MODE="split"
MEDIA_TYPES_FLAG=3

AWS_REGION="us-east-1"
# Optional. The SDK also supports IAM roles, web identity, IAM Identity Center,
# shared AWS config/credentials files, ECS, EC2, and standard AWS_* variables.
# AWS_PROFILE="default"
S3_BUCKET="YOUR_S3_BUCKET_HERE"
S3_PREFIX="rtms"
S3_SERVER_SIDE_ENCRYPTION="AES256"
# Used when S3_SERVER_SIDE_ENCRYPTION is aws:kms or aws:kms:dsse.
S3_KMS_KEY_ID=""
S3_BUCKET_KEY_ENABLED=true
S3_MULTIPART_PART_SIZE_MB=16
S3_MULTIPART_CONCURRENCY=4
AWS_MAX_ATTEMPTS=3

# Reject webhook signatures outside this replay window.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Durable processing, retry, recovery, and retention
RECORDINGS_DIR="recordings"
UPLOAD_QUEUE_CONCURRENCY=1
UPLOAD_MAX_ATTEMPTS=5
UPLOAD_RETRY_BASE_SECONDS=5
UPLOAD_RETRY_MAX_SECONDS=300
RECOVERY_STALE_AFTER_MINUTES=10
RECOVERY_SCAN_INTERVAL_MINUTES=5
DELETE_LOCAL_AFTER_UPLOAD=true
# Used only when DELETE_LOCAL_AFTER_UPLOAD=false. Set to -1 to retain forever.
COMPLETED_MEDIA_RETENTION_HOURS=24
# Set to -1 to retain failed media forever.
FAILED_MEDIA_RETENTION_DAYS=7
# Queue records are retained after local media cleanup. Set to -1 to retain forever.
QUEUE_RECORD_RETENTION_DAYS=30
CLEANUP_INTERVAL_MINUTES=60
SHUTDOWN_TIMEOUT_MS=30000
FFMPEG_PATH="ffmpeg"
