{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "storage/save_audio_and_video_to_aws_s3_storage_js/Dockerfile",
    "watchPatterns": [
      "/storage/save_audio_and_video_to_aws_s3_storage_js/**",
      "/library/javascript/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "requiredMountPath": "/workspace/rtms-samples/storage/save_audio_and_video_to_aws_s3_storage_js/recordings"
  }
}
