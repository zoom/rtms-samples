[Unit]
Description=Zoom RTMS sample service on port %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rtms
Group=rtms
WorkingDirectory=/var/www/rtms-sample/rtms-samples/bot-to-rtms-migration
Environment=NODE_ENV=production
EnvironmentFile=/var/www/rtms-sample/rtms-samples/bot-to-rtms-migration/.env
ExecStart=/usr/bin/node 50-start-and-approval/server.js
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
