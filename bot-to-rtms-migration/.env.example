# Copy to .env and fill in. Never commit .env.
# `npm run live` (50-start-and-approval) reads this file and connects to REAL Zoom RTMS servers.
# Tests and the seeded dashboard demo run offline without it.

# From your Marketplace app (App Credentials, and Features > Access for the secret token). All three are required.
# ZOOM_SECRET_TOKEN verifies webhooks. ZOOM_CLIENT_ID is sent in REST start requests.
# ZOOM_CLIENT_SECRET signs the signaling and media handshakes with Zoom's RTMS servers.
ZOOM_SECRET_TOKEN=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
WEBHOOK_PATH=/webhook

# Public https base of this deployment; appears only in a human-facing authorization error hint.
# PUBLIC_BASE_URL=https://rtms.example.com

# Which Zoom accounts may open a stream (comma separated account IDs). Not sure of yours? Start the
# server once, trigger a stream, and copy "accountId" from the stream_refused log line.
# Or set TENANTS_FILE to a JSON list for several tenants (see 50-start-and-approval/tenants.sample.json).
TENANT_ACCOUNT_IDS=
TENANT_ID=local
TENANT_CONSENT_REF=local-dev-consent

# What to receive from each stream: audio, video, share, transcript, chat (comma separated).
RTMS_MEDIA=audio,transcript
# Video: activeSpeaker (one mixed active-speaker stream) or individual (one selected person at a time, follows the first person with video on).
RTMS_VIDEO_MODE=activeSpeaker
# true also delivers media buffered before the handshake finished. The reference library sends false.
RTMS_BUFFER_DATA=false
# Reconnect windows in seconds after a disconnect: 60 to get signaling back and 30 to get media back.
RTMS_SIGNALING_WINDOW_SEC=60
RTMS_MEDIA_WINDOW_SEC=30
RTMS_RECONNECT_BASE_MS=1000
RTMS_RECONNECT_CAP_MS=15000
RTMS_RECONNECT_MAX_ATTEMPTS=8
# Audio and transcript formats. Stereo needs the opus codec. Transcript language 9 is English.
RTMS_AUDIO_CODEC=l16
RTMS_AUDIO_SAMPLE_RATE=16000
RTMS_AUDIO_CHANNELS=mono
RTMS_TRANSCRIPT_LANGUAGE_ID=9
RTMS_TRANSCRIPT_DETECT_LANGUAGE=true
# Where each stream writes manifest.json (and transcript.jsonl if enabled).
RTMS_OUTPUT_DIR=.data/streams
# Transcript text is content. It is not logged unless you ask: PRINT writes it to the log, SAVE appends it to transcript.jsonl.
RTMS_PRINT_TRANSCRIPT=false
RTMS_SAVE_TRANSCRIPT=false
RTMS_STATS_EVERY_SEC=10

# 50: REST start, stop, pause and resume. Needs scope meeting:update:participant_rtms_app_status.
# RTMS acts for one Zoom user, so the real token is that user's. Users authorize through /oauth/authorize
# (see the OAuth settings below) and the server keeps one refreshing token per user.
# ZOOM_ACCESS_TOKEN is a single-token shortcut for a quick test. Leave it blank to use per-user tokens,
# and leave both unset to run in dry-run mode (no calls to api.zoom.us).
ZOOM_ACCESS_TOKEN=
PORT_03=4803
# Bind address. Keep 127.0.0.1 unless a reverse proxy in front terminates TLS.
HOST=127.0.0.1
# Require "Authorization: Bearer <token>" on /api/start, /api/stop and /api/state.
ADMIN_API_TOKEN=
# JSON list of tenants. Defaults to 50-start-and-approval/tenants.sample.json.
TENANTS_FILE=
START_WATCHDOG_MS=60000
CLAIM_LEASE_MS=45000

# 50: user authorization (OAuth). Set the redirect URL in your Marketplace app to the same value.
# Routes: GET /oauth/authorize, GET /oauth/callback, POST /oauth/deauthorize (set as the app's deauthorization URL).
ZOOM_REDIRECT_URI=
# Where per-user tokens are kept. They are secrets: the file store writes owner-only files and is for
# development. In production use your secret store. OAUTH_STORE=memory keeps them in memory only.
OAUTH_TOKEN_DIR=.data/oauth
OAUTH_STORE=file
# Comma separated scopes every user must have granted, for example meeting:read:meeting_audio,meeting:update:participant_rtms_app_status.
# A user whose token lacks one is marked reauthorization_required instead of being retried.
OAUTH_REQUIRED_SCOPES=

# 50: what to do when two users of your app are in the same meeting.
#   first_wins  open the first stream and decline a different user's second stream while the first is live (default)
#   keep_both   open every stream (each one uses a concurrent stream and credits)
MEETING_POLICY=first_wins
# Stop a declined stream by REST, with that user's own token, so it does not sit unconnected. Set false to only log it.
STOP_DECLINED_STREAMS=true
# Optional rule for "should we process this meeting?". A module whose default export is
# (stream) => true | false | { capture, reason }. Declined streams are handled like duplicates.
CAPTURE_FILTER_MODULE=

# Trace file shared by 50-start-and-approval, 60-stream-lifecycle-client and 61-media-and-participants, read by 70-reporting-dashboard. One JSON line per event.
# This is a demo trace, not a datastore. Replace with your own logging/analytics pipeline.
TRACE_FILE=.data/events.jsonl

# 70: reporting dashboard.
PORT_06=4806
# Only show the last N hours of the trace. 0 shows everything.
REPORT_HOURS=0
