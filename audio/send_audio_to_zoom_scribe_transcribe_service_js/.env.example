PORT=3000
WEBHOOK_PATH=/webhook
RTMSTRIGGERMANAGERTYPE=webhook
MEDIA_SOCKET_CONNECTION_MODE=split

# Zoom RTMS app credentials
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"

# Optional S2S / WebSocket trigger credentials if using RTMSTRIGGERMANAGERTYPE=websocket
ZOOM_S2S_CLIENT_ID="YOUR_ZOOM_S2S_CLIENT_ID_HERE"
ZOOM_S2S_CLIENT_SECRET="YOUR_ZOOM_S2S_CLIENT_SECRET_HERE"
ZOOM_ACCOUNT_ID="YOUR_ZOOM_ACCOUNT_ID_HERE"
zoomWSURLForEvents=

# Zoom AI Services Scribe authentication.
# Scribe uses a Build-platform HS256 JWT:
# - ZOOM_API_KEY is the JWT issuer (`iss`) / Build-platform credential key.
# - ZOOM_API_SECRET signs the JWT.
# These are separate from ZOOM_CLIENT_ID / ZOOM_CLIENT_SECRET used for RTMS.
ZOOM_API_KEY="YOUR_ZOOM_API_KEY_HERE"
ZOOM_API_SECRET="YOUR_ZOOM_API_SECRET_HERE"
# Full WebSocket URL of the live transcription endpoint.
SCRIBE_LIVE_URL=wss://api.zoom.us/v2/aiservices/scribe/live

# Live Scribe (real-time streaming) settings.
SCRIBE_LANGUAGE=en-US
SCRIBE_WORD_TIME_OFFSETS=true
SCRIBE_TIMESTAMPS=true
SCRIBE_DIARIZATION=false
SCRIBE_LOG_RAW_EVENTS=false
SCRIBE_CHANNEL_SEPARATION=false
SCRIBE_PROFANITY_FILTER=false
SCRIBE_OUTPUT_FORMAT=json

# Reject webhook signatures outside this replay window.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
