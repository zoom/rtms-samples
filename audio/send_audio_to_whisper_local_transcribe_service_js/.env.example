# Zoom RTMS Credentials
ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"

# Server Configuration
PORT=3000
WEBHOOK_PATH=/webhook

# Whisper Configuration
# Model options: tiny, base, small, medium, large, large-v2, large-v3
# Smaller models are faster but less accurate
# tiny: ~1 sec processing per 3 sec audio (CPU)
# base: ~2 sec processing per 3 sec audio (CPU)
# small: ~5 sec processing per 3 sec audio (CPU)
WHISPER_MODEL=tiny

# Language code (e.g., en, es, fr, de, zh, ja, ko)
# Set to empty string for auto-detection
WHISPER_LANGUAGE=en

# Audio chunk duration in milliseconds
# Shorter = lower latency but potentially less accurate
# Longer = higher latency but more context for better accuracy
# Recommended: 2000-5000ms
WHISPER_CHUNK_DURATION_MS=3000

# Reject webhook signatures outside this replay window.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Additional runtime configuration
MEDIA_SOCKET_CONNECTION_MODE="split"
RTMSTRIGGERMANAGERTYPE="webhook"
ZOOM_ACCOUNT_ID="YOUR_ZOOM_ACCOUNT_ID_HERE"
ZOOM_S2S_CLIENT_ID="YOUR_ZOOM_S2S_CLIENT_ID_HERE"
ZOOM_S2S_CLIENT_SECRET="YOUR_ZOOM_S2S_CLIENT_SECRET_HERE"
zoomWSURLForEvents=""
