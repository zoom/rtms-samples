{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "audio/send_audio_to_openai_realtime_api/Dockerfile",
    "watchPatterns": [
      "/audio/send_audio_to_openai_realtime_api/**",
      "/library/javascript/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
