ZOOM_SECRET_TOKEN="YOUR_ZOOM_SECRET_TOKEN_HERE"
ZOOM_CLIENT_ID="YOUR_ZOOM_CLIENT_ID_HERE"
ZOOM_CLIENT_SECRET="YOUR_ZOOM_CLIENT_SECRET_HERE"
PORT=5050
WEBHOOK_PATH="/"
AUDIO_SAMPLE_RATE=48000
TARGET_CHUNK_DURATION_MS=100

OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"
OPENAI_REALTIME_ENABLED=true
OPENAI_REALTIME_MODEL="gpt-realtime-2"
OPENAI_AUDIO_SAMPLE_RATE=24000
OPENAI_REALTIME_TRANSCRIPTION_ENABLED=true
OPENAI_REALTIME_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
OPENAI_REALTIME_COST_LOGGING_ENABLED=true
OPENAI_REALTIME_TEXT_INPUT_PRICE_PER_1M=4
OPENAI_REALTIME_TEXT_OUTPUT_PRICE_PER_1M=24
OPENAI_REALTIME_AUDIO_INPUT_PRICE_PER_1M=32
OPENAI_REALTIME_AUDIO_OUTPUT_PRICE_PER_1M=64

ZOOM_MCP_SERVER_LABEL="zoom"
ZOOM_MCP_SERVER_URL="https://mcp.zoom.us/mcp/zoom/streamable"
ZOOM_MCP_ACCESS_TOKEN="YOUR_ZOOM_MCP_ACCESS_TOKEN_HERE"
ZOOM_MCP_ALLOWED_TOOLS="search_meetings,search_zoom,get_meeting_assets,get_recording_resource,get_file_content,recordings_list,create_new_file_with_markdown"
ZOOM_MCP_REQUIRE_APPROVAL="never"
OPENAI_REALTIME_LOG_RAW_MCP_OUTPUT=false
OPENAI_REALTIME_MCP_OUTPUT_PREVIEW_CHARS=500

# Reject webhook signatures outside this replay window.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Additional runtime configuration
MEDIA_SOCKET_CONNECTION_MODE="split"
OPENAI_MAX_QUEUED_AUDIO_BYTES=2097152
OPENAI_REALTIME_DEBUG_EVENTS=false
OPENAI_REALTIME_RECONNECT_DELAY_MS=2000
OPENAI_SAFETY_IDENTIFIER=""
RTMSTRIGGERMANAGERTYPE="webhook"
ZOOM_ACCOUNT_ID="YOUR_ZOOM_ACCOUNT_ID_HERE"
ZOOM_S2S_CLIENT_ID="YOUR_ZOOM_S2S_CLIENT_ID_HERE"
ZOOM_S2S_CLIENT_SECRET="YOUR_ZOOM_S2S_CLIENT_SECRET_HERE"
zoomWSURLForEvents=""
