PORT=3000
WEBHOOK_PATH=/webhook
RTMSTRIGGERMANAGERTYPE=webhook
MEDIA_SOCKET_CONNECTION_MODE=split

# Zoom RTMS app credentials
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SECRET_TOKEN=

# Optional S2S / WebSocket trigger credentials if using RTMSTRIGGERMANAGERTYPE=websocket
ZOOM_S2S_CLIENT_ID=
ZOOM_S2S_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=
zoomWSURLForEvents=

# Zoom AI Services Scribe authentication.
# Scribe uses a Build-platform HS256 JWT:
# - ZOOM_API_KEY is the JWT issuer (`iss`) / Build-platform credential key.
# - ZOOM_API_SECRET signs the JWT.
# These are separate from ZOOM_CLIENT_ID / ZOOM_CLIENT_SECRET used for RTMS.
ZOOM_API_KEY=
ZOOM_API_SECRET=
# Full WebSocket URL of the live transcription endpoint.
SCRIBE_LIVE_URL=wss://api.zoom.us/v2/aiservices/scribe/live

# Live Scribe (real-time streaming) settings.
SCRIBE_LANGUAGE=en-US
SCRIBE_WORD_TIME_OFFSETS=true
SCRIBE_TIMESTAMPS=true
SCRIBE_DIARIZATION=false
SCRIBE_CHANNEL_SEPARATION=false
SCRIBE_PROFANITY_FILTER=false
SCRIBE_OUTPUT_FORMAT=json
# Optional JSON vocabulary. Leave empty to omit it from session.update.
SCRIBE_VOCABULARY_JSON=
# Example: SCRIBE_VOCABULARY_JSON={"phrases":["AIAGW","Zoom AI Companion"],"pronunciations":[{"phrase":"AIAGW","pronunciation":"A I A gateway"}],"aliases":[{"canonical":"Zoom AI Companion","variants":["AI Companion","Zoom Companion"]}]}

# Two sockets start immediately. Set capacity to 3 to allow one lazy third socket.
SCRIBE_POOL_SIZE=3
# Send a short PCM silence heartbeat after this much Scribe audio inactivity.
SCRIBE_HEARTBEAT_IDLE_MS=10000
# Silence duration per heartbeat. One second is long enough for Scribe to ingest.
SCRIBE_HEARTBEAT_AUDIO_MS=1000
SCRIBE_RECONNECT_DELAY_MS=2000
# Active-participant audio retained while its socket connects or reconnects.
SCRIBE_PENDING_AUDIO_MAX_BYTES=160000

# Save the final named, time-sorted transcript as JSON when the meeting stops.
SCRIBE_SAVE_DIARIZED_TRANSCRIPT=false
SCRIBE_TRANSCRIPT_OUTPUT_DIR=diarized_transcripts

# Reject webhook signatures outside this replay window.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
